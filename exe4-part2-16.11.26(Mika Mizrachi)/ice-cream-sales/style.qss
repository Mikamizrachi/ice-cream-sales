QWidget { background-color: #f4f6fa; font-size: 14px; }
QPushButton {
	background-color: #3b6fd8; color: white;
	border-radius: 6px; padding: 8px 14px;
}
QPushButton:hover { background-color: #2c58b3; }
QTableWidget { background-color: white; gridline-color: #d0d5e0; }
QHeaderView::section { background-color: #dde4f3; font-weight: bold; padding: 4px; }
QSpinBox { padding: 4px; background-color: white; }
